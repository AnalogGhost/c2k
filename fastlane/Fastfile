require "open3"
require "shellwords"
require_relative "release_checks"

default_platform(:android)

# Runs git in the project as ReleaseChecks expects: an argument list in, [stdout, success] out.
def git_runner(project_dir)
  lambda do |args|
    out, status = Open3.capture2("git", "-C", project_dir, *args)
    [out, status.success?]
  end
end

# Runs every pre-release check and returns [version_name, version_code], or stops the lane with
# all the problems at once. Nothing here changes the repository or publishes anything.
def release_preflight(project_dir)
  version_name, version_code = ReleaseChecks.version_info(File.read(File.join(project_dir, "app/build.gradle.kts")))
  UI.user_error!("Couldn't find versionName/versionCode in app/build.gradle.kts") unless version_name && version_code

  errors = ReleaseChecks.changelog_errors(File.join(project_dir, "fastlane/metadata/android"), version_code) +
           ReleaseChecks.git_errors("v#{version_name}", git: git_runner(project_dir))
  unless errors.empty?
    UI.user_error!("Not ready to release v#{version_name} (versionCode #{version_code}):\n  - " + errors.join("\n  - "))
  end
  [version_name, version_code]
end

platform :android do
  desc "Build the debug APK + test APK, capture raw store-listing screenshots in every locale"
  desc "(into fastlane/metadata/android — F-Droid's plain set), then composite the framed/"
  desc "captioned marketing set (into fastlane/metadata/android-play) for Play Store upload."
  lane :screenshots do
    gradle(task: "assembleFossDebug assembleFossDebugAndroidTest")
    capture_android_screenshots
    sh("python3", "../tools/store-screenshots/build.py")
  end

  desc "Build the Play release AAB and upload it plus store listing metadata to Google Play"
  desc "Defaults to a dry run (validate_only) against the internal track — pass track:production"
  desc "and validate_only:false to actually publish."
  lane :playstore do |options|
    gradle(task: "bundlePlayRelease")

    upload_to_play_store(
      track: options[:track] || "internal",
      aab: Dir["app/build/outputs/bundle/playRelease/*.aab"].first,
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      # Images/screenshots rarely change between releases, and uploading them for
      # every locale multiplies flaky Play API calls (500s, dropped connections).
      # Pass skip_images:false / skip_screenshots:false when they actually changed.
      skip_upload_images: options[:skip_images].nil? ? true : options[:skip_images],
      skip_upload_screenshots: options[:skip_screenshots].nil? ? true : options[:skip_screenshots],
      validate_only: options[:validate_only].nil? ? true : options[:validate_only]
    )
  end

  desc "Upload only the store-listing text (titles/descriptions) to Google Play — no build,"
  desc "no AAB, no images, no changelogs. For listing-copy fixes between releases."
  desc "Defaults to a dry run; pass validate_only:false to publish."
  lane :metadata do |options|
    upload_to_play_store(
      track: options[:track] || "production",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      validate_only: options[:validate_only].nil? ? true : options[:validate_only]
    )
  end

  desc "Upload only store screenshots/images to Google Play — no build, no AAB, no listing"
  desc "text, no changelogs. For refreshed screenshots between releases."
  desc "Reads from fastlane/metadata/android-play, the framed/captioned marketing set generated"
  desc "by `python3 tools/store-screenshots/build.py` — NOT fastlane/metadata/android, which"
  desc "stays plain/raw for F-Droid."
  desc "Defaults to a dry run; pass validate_only:false to publish."
  lane :images do |options|
    upload_to_play_store(
      track: options[:track] || "production",
      metadata_path: "./fastlane/metadata/android-play",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      validate_only: options[:validate_only].nil? ? true : options[:validate_only]
    )
  end

  desc "Upload only changelogs (release notes) to Google Play — no build, no AAB, no images,"
  desc "no listing text. For fixing or adding a missed changelog translation after a release."
  desc "Requires version_code (the release this changelog belongs to)."
  desc "Defaults to a dry run; pass validate_only:false to publish."
  lane :changelogs do |options|
    UI.user_error!("Pass version_code: e.g. fastlane changelogs version_code:16") unless options[:version_code]
    upload_to_play_store(
      track: options[:track] || "production",
      metadata_path: "./fastlane/metadata/android",
      version_code: options[:version_code],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_metadata: true,
      validate_only: options[:validate_only].nil? ? true : options[:validate_only]
    )
  end

  desc "Check, without changing or publishing anything, that the current version can be released:"
  desc "a changelog in every listing locale within Play's 500 characters, HEAD on main and pushed,"
  desc "and the version's tag not yet used. The release lane runs the same checks first."
  lane :release_check do
    project_dir = File.expand_path("..", __dir__)
    version_name, version_code = release_preflight(project_dir)
    UI.success("Ready to release v#{version_name} (versionCode #{version_code})")
  end

  desc "Tag, reproducibly build, sign, and publish a GitHub release for F-Droid."
  desc "Run this only after the version bump + changelog commit is already made and pushed-"
  desc "worthy — see project release checklist. Pauses for confirmation before anything public"
  desc "(push, GitHub release) happens; the docker build and signing run first so you can see"
  desc "the real SHA-256 before deciding."
  lane :release do
    project_dir = File.expand_path("..", __dir__)

    ensure_git_status_clean
    version_name, version_code = release_preflight(project_dir)
    tag = "v#{version_name}"

    UI.header("Releasing #{tag} (versionCode #{version_code})")

    sha256 = release_apk = nil
    ReleaseChecks.with_local_tag(tag, git: git_runner(project_dir)) do
      UI.message("Running reproducible docker build (this takes a few minutes)...")
      sh("bash '#{project_dir}/docker-build.sh'")

      UI.message("Signing...")
      local_props = ReleaseChecks.parse_properties(File.read(File.join(project_dir, "local.properties")))
      store_pass = local_props["storePassword"]
      key_pass = local_props["keyPassword"]
      UI.user_error!("Missing storePassword/keyPassword in local.properties") if store_pass.to_s.empty? || key_pass.to_s.empty?
      key_alias = local_props["keyAlias"].to_s.empty? ? "c2k" : local_props["keyAlias"]

      keystore = local_props["storeFile"]
      keystore = File.join(project_dir, "release/c2k-release.jks") unless keystore && File.exist?(keystore)
      UI.user_error!("Signing keystore not found at #{keystore}") unless File.exist?(keystore)

      unsigned_apk = File.join(project_dir, "app/build/outputs/apk/foss/release/app-foss-release-unsigned.apk")
      signed_apk = File.join(project_dir, "app/build/outputs/apk/foss/release/app-foss-release-signed.apk")
      release_apk = File.join(project_dir, "app/build/outputs/apk/foss/release/app-release.apk")

      android_sdk = ENV["ANDROID_SDK_ROOT"] || ENV["ANDROID_HOME"] || File.join(ENV["HOME"], "Android/Sdk")
      apksigner = Dir[File.join(android_sdk, "build-tools", "*", "apksigner")]
        .max_by { |path| Gem::Version.new(File.basename(File.dirname(path))) }
      UI.user_error!("Couldn't find apksigner under #{android_sdk}/build-tools") unless apksigner

      # No shell, and the passwords reach apksigner through its environment (env:NAME) rather
      # than its arguments, which any local process can read from /proc while it runs.
      env, argv = ReleaseChecks.apksigner_invocation(
        apksigner: apksigner, keystore: keystore, key_alias: key_alias,
        store_pass: store_pass, key_pass: key_pass, out: signed_apk, input: unsigned_apk
      )
      signed = system(env, *argv)
      UI.user_error!("apksigner failed to sign #{unsigned_apk}") unless signed
      sh("cp '#{signed_apk}' '#{release_apk}'")

      sha256 = sh("sha256sum '#{release_apk}' | cut -d' ' -f1").strip

      UI.important("Built and signed #{tag}. SHA-256: #{sha256}")
      UI.important("Local tag created but NOT pushed yet — nothing public has happened. Answering no removes it.")
      UI.user_error!("Aborted, nothing pushed.") unless UI.confirm("Push #{tag} to origin and create the GitHub release now?")

      sh("git push origin #{tag.shellescape}")
      true  # pushed: keep the tag. Any failure above removes it again (see with_local_tag).
    end

    # Present: release_preflight refused to start without it.
    notes = File.read(File.join(project_dir, "fastlane/metadata/android/en-US/changelogs/#{version_code}.txt"))
    body = "## What's new\n\n#{notes}\n## SHA-256\n\n`#{sha256}`\n"

    sh("gh release create #{tag.shellescape} #{release_apk.shellescape} --title #{tag.shellescape} --notes #{body.shellescape}")

    UI.success("Released #{tag}: https://github.com/AnalogGhost/c2k/releases/tag/#{tag}")
  end
end
